<Layouts.flash_group flash={@flash} />

<section class="bg-base-200/40 min-h-[60vh] flex items-center">
  <div class="mx-auto w-full max-w-lg px-6 py-20">
    <div class="card bg-base-100 border border-base-200 shadow-sm">
      <div class="card-body p-8 text-center items-center gap-4">
        <%= case @state do %>
          <% :confirm -> %>
            <.icon name="hero-envelope" class="size-10 text-primary" />
            <h1 class="text-2xl font-bold tracking-tight">Unsubscribe from our newsletter?</h1>
            <p class="text-base-content/70">
              <span class="font-medium text-base-content">{@email}</span>
              will no longer receive emails from Biosphere Native Plants.
            </p>
            <form
              id="unsubscribe-form"
              method="post"
              action={~p"/newsletter/unsubscribe/#{@token}"}
              class="pt-2"
            >
              <.button class="btn btn-primary gap-2">
                <.icon name="hero-check" class="size-5" /> Yes, unsubscribe me
              </.button>
            </form>
            <.link href={~p"/"} class="text-sm text-base-content/60 hover:text-base-content">
              No, keep me subscribed
            </.link>
          <% :done -> %>
            <.icon name="hero-check-circle" class="size-10 text-success" />
            <h1 class="text-2xl font-bold tracking-tight">You're unsubscribed</h1>
            <p class="text-base-content/70">
              You won't receive any more newsletter emails from us. Changed your mind?
              You can sign up again any time.
            </p>
            <.link href={~p"/"} class="btn btn-ghost gap-2">
              <.icon name="hero-arrow-left" class="size-4" /> Back to the home page
            </.link>
          <% :invalid -> %>
            <.icon name="hero-exclamation-triangle" class="size-10 text-warning" />
            <h1 class="text-2xl font-bold tracking-tight">This link isn't valid</h1>
            <p class="text-base-content/70">
              The unsubscribe link may be incomplete. Try copying the whole link from the
              email, or
              <.link href={~p"/contact"} class="text-primary hover:underline">contact us</.link>
              and we'll remove you.
            </p>
        <% end %>
      </div>
    </div>
  </div>
</section>
