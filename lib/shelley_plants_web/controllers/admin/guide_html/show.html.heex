<Layouts.flash_group flash={@flash} />

<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-10">
  <.link navigate={~p"/admin"} class="btn btn-ghost btn-sm gap-2 mb-6">
    <.icon name="hero-arrow-left" class="size-4" /> Back to admin
  </.link>

  <article class={[
    "leading-relaxed text-base-content",
    "[&_h1]:font-serif [&_h1]:text-3xl [&_h1]:font-bold [&_h1]:mb-4",
    "[&_h2]:font-serif [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:mt-10 [&_h2]:mb-3",
    "[&_h3]:font-semibold [&_h3]:text-base [&_h3]:mt-6 [&_h3]:mb-2",
    "[&_p]:my-3 [&_p]:text-base-content/80",
    "[&_ul]:list-disc [&_ul]:pl-6 [&_ul]:my-3 [&_ul]:space-y-1",
    "[&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:my-3 [&_ol]:space-y-1",
    "[&_li]:text-base-content/80",
    "[&_a]:text-primary [&_a]:underline [&_a]:underline-offset-2",
    "[&_code]:bg-base-200 [&_code]:rounded [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-sm",
    "[&_pre]:bg-base-200 [&_pre]:rounded-xl [&_pre]:p-4 [&_pre]:overflow-x-auto [&_pre]:my-4",
    "[&_pre_code]:bg-transparent [&_pre_code]:p-0",
    "[&_table]:w-full [&_table]:text-sm [&_table]:my-4",
    "[&_th]:text-left [&_th]:border-b [&_th]:border-base-300 [&_th]:py-1.5 [&_th]:pr-4",
    "[&_td]:border-b [&_td]:border-base-200 [&_td]:py-1.5 [&_td]:pr-4",
    "[&_hr]:border-base-200 [&_hr]:my-8",
    "[&_strong]:font-semibold [&_strong]:text-base-content",
    "[&_em]:italic"
  ]}>
    {raw(@guide_html)}
  </article>
</div>
